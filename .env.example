# ==============================================================================
# AUIPR Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual production/staging values.
# ==============================================================================

# MongoDB Connection String (Atlas Cluster or local instance)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/auipr_db?retryWrites=true&w=majority

# MongoDB Database Name (Optional, defaults to auipr_db)
MONGODB_DB_NAME=auipr_db

# Secret HMAC key used to sign and verify administrative JWT session tokens
AUTH_SECRET=your_secure_random_hmac_secret_key_here

# Role-Based Access Control (RBAC) Admin Passwords (Optional overrides)
# ADMIN_GENERAL_PASS=your_super_admin_password
# ADMIN_LEBANON_PASS=your_lebanon_branch_password
# ADMIN_JORDAN_PASS=your_jordan_branch_password
